import "JetBrainsMono-Regular.ttf";

export struct PadView {
    number: string,
    key: string,
    note: string,
    effect: string,
    held: bool,
    active: bool,
    suspended: bool,
    selected: bool,
}

export struct MacroView {
    label: string,
    value: float,
    value-text: string,
    enabled: bool,
}

component InstrumentSwitch inherits Rectangle {
    in-out property <bool> checked: true;
    in property <string> label: "";
    callback toggled(bool);

    height: 28px;
    width: 146px;
    border-radius: 4px;
    background: #232726;
    border-width: 1px;
    border-color: root.checked ? #e5fa36 : #676767;

    HorizontalLayout {
        padding: 4px;
        spacing: 7px;

        Rectangle {
            width: 32px;
            background: root.checked ? #e5fa36 : #202020;
            border-width: 1px;
            border-color: root.checked ? #e5fa36 : #676767;

            Text {
                text: root.checked ? "ON" : "OFF";
                color: root.checked ? #080808 : #b7b4a9;
                font-size: 9px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.label;
            color: root.checked ? #f5f2e9 : #858278;
            font-size: 9px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }

    TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

component InstrumentButton inherits Rectangle {
    in property <string> label: "";
    callback clicked();

    min-width: 0px;
    height: 34px;
    border-radius: 4px;
    background: touch.pressed ? #e5fa36 : #232726;
    border-width: 1px;
    border-color: touch.has-hover ? #e5fa36 : #676767;

    Text {
        text: root.label;
        color: touch.pressed ? #080808 : touch.has-hover ? #e5fa36 : #f5f2e9;
        font-size: 9px;
        font-weight: 900;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component InstrumentKnob inherits Rectangle {
    in property <float> value: 0.0;
    in property <string> value-text: "";
    in property <string> label: "";
    in property <bool> enabled: true;
    in property <bool> interactive: true;
    in property <bool> type-selector: false;
    callback edit-began();
    callback value-changed(float);
    callback edit-ended();

    min-width: 0px;
    min-height: 0px;
    preferred-width: 82px;
    preferred-height: 82px;
    background: transparent;
    opacity: root.enabled ? 1.0 : 0.32;
    property <length> dial-size: min(78px, min(root.width - 14px, root.height - 40px));
    property <length> dial-top: max(4px, (root.height - root.dial-size - 40px) / 2);

    Rectangle {
        x: 6px; y: parent.height - 1px;
        width: parent.width - 12px; height: 1px;
        background: #454b47;
    }
    property <float> angle: 135 + root.value * 270;

    Path {
        x: (parent.width - root.dial-size) / 2;
        y: root.dial-top;
        width: root.dial-size;
        height: root.dial-size;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 64;
        viewbox-height: 64;
        stroke: #4c524e;
        stroke-width: 5px;

        MoveTo { x: 32 + 27 * cos(135deg); y: 32 + 27 * sin(135deg); }
        ArcTo {
            x: 32 + 27 * cos(405deg);
            y: 32 + 27 * sin(405deg);
            radius-x: 27;
            radius-y: 27;
            sweep: true;
            large-arc: true;
        }
    }

    Path {
        x: (parent.width - root.dial-size) / 2;
        y: root.dial-top;
        width: root.dial-size;
        height: root.dial-size;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 64;
        viewbox-height: 64;
        stroke: root.enabled ? #e5fa36 : #4c524e;
        stroke-width: 5px;

        MoveTo { x: 32 + 27 * cos(135deg); y: 32 + 27 * sin(135deg); }
        ArcTo {
            x: 32 + 27 * cos(root.angle * 1deg);
            y: 32 + 27 * sin(root.angle * 1deg);
            radius-x: 27;
            radius-y: 27;
            sweep: true;
            large-arc: root.value > 0.667;
        }
    }

    Path {
        x: (parent.width - root.dial-size) / 2;
        y: root.dial-top;
        width: root.dial-size;
        height: root.dial-size;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 64;
        viewbox-height: 64;
        stroke: #f5f2e9;
        stroke-width: 2px;

        MoveTo { x: 32; y: 32; }
        LineTo {
            x: 32 + 18 * cos(root.angle * 1deg);
            y: 32 + 18 * sin(root.angle * 1deg);
        }
    }

    Text {
        x: 3px;
        y: root.dial-top + root.dial-size + 2px;
        width: parent.width - 6px;
        height: 15px;
        text: root.enabled ? root.value-text : "—";
        color: root.enabled ? #f5f2e9 : #6b6962;
        font-size: 10px;
        font-weight: 700;
        horizontal-alignment: center;
        overflow: elide;
    }

    Rectangle {
        x: 2px;
        y: root.dial-top + root.dial-size + 19px;
        width: parent.width - 4px; height: 16px;
        border-radius: 3px;
        background: root.type-selector ? #e5fa36 : transparent;
    }

    Text {
        x: 3px;
        y: root.dial-top + root.dial-size + 20px;
        width: parent.width - 6px;
        height: 14px;
        text: root.enabled ? root.label : "INACTIVE";
        color: root.type-selector ? #202523 : root.enabled ? #e5fa36 : #5a5852;
        font-size: 9px;
        font-weight: 800;
        horizontal-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        enabled: root.enabled && root.interactive;
        property <float> start-value: 0.0;
        property <bool> editing: false;

        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                self.start-value = root.value;
                self.editing = true;
                root.edit-began();
            }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.up && self.editing {
                self.editing = false;
                root.edit-ended();
            }
        }

        moved => {
            if self.pressed && self.editing {
                root.value-changed(clamp(
                    self.start-value - (self.mouse-y - self.pressed-y) / 145px,
                    0.0,
                    1.0,
                ));
            }
        }
    }
}

component PerformancePad inherits Rectangle {
    in property <PadView> data;
    in property <int> index;
    callback pressed(int);
    callback released(int);

    min-width: 0px;
    min-height: 0px;
    preferred-width: 112px;
    preferred-height: 58px;
    background: root.data.suspended ? #482d23
        : touch.pressed || root.data.held ? #e5fa36
        : touch.has-hover ? #ffffff : #f5f2e9;
    border-radius: 5px;
    border-width: root.data.selected ? 3px : 1px;
    border-color: root.data.suspended ? #ff936e
        : root.data.selected ? #e5fa36 : #d3d1c7;

    Rectangle {
        x: 7px; y: 9px; width: 3px; height: parent.height - 18px;
        background: root.data.selected ? #67731c : transparent;
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: root.height < 46px ? 3px : 10px;
        padding-bottom: root.height < 46px ? 3px : 10px;
        spacing: 4px;
        Text {
            width: 24px;
            text: root.data.key;
            color: root.data.suspended ? #ffb494 : #202523;
            font-size: root.height < 46px ? 24px : 28px;
            font-weight: 800;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            Text {
                text: root.data.effect;
                color: root.data.suspended ? #ffb494 : #202523;
                font-size: 12px;
                font-weight: 800;
                overflow: elide;
            }
            Text {
                text: root.data.suspended ? "WAIT / " + root.data.number
                    : root.data.active ? "ACTIVE / " + root.data.number
                    : root.data.held ? "HELD / " + root.data.number
                    : "MIDI " + root.data.note + " / " + root.data.number;
                color: root.data.suspended ? #ffb494 : #64675e;
                font-size: 9px;
                overflow: elide;
            }
        }
    }

    touch := TouchArea {
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.pressed(root.index);
            }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                root.released(root.index);
            }
        }
    }
}

component WaveformPanel inherits Rectangle {
    in property <string> left-path;
    in property <string> right-path;
    in property <float> playhead;
    in property <bool> captured;
    in property <string> mode;
    in property <string> status;

    background: root.captured ? #262d21 : #232726;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.captured ? #e5fa36 : #232726;

    VerticalLayout {
        padding: 12px;
        spacing: 5px;

        HorizontalLayout {
            height: 22px;
            spacing: 8px;

            Text {
                text: root.captured ? "CAPTURED PERFORMANCE CELL" : "STEREO BUFFER MONITOR";
                color: root.captured ? #e5fa36 : #f5f2e9;
                font-size: 12px;
                font-weight: 900;
                vertical-alignment: center;
            }

            Rectangle {
                width: root.captured ? 138px : 160px;
                background: root.captured ? #e5fa36 : transparent;
                border-width: root.captured ? 0px : 1px;
                border-color: #353531;

                Text {
                    text: root.mode;
                    color: root.captured ? #080808 : #e5fa36;
                    font-size: 10px;
                    font-weight: 900;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            background: #202423;
            border-width: 1px;
            border-color: root.captured ? #687300 : #353531;
            vertical-stretch: 1;

            for beat in 17: Rectangle {
                x: beat * (parent.width - 1px) / 16;
                width: 1px; height: parent.height;
                background: Math.mod(beat, 4) == 0 ? #646961 : #373e38;
            }
            for line in 4: Rectangle {
                x: 0px;
                y: (line + 1) * parent.height / 5;
                width: parent.width;
                height: 1px;
                background: root.captured ? #30351e : #292925;
            }

            Rectangle {
                y: parent.height / 2;
                width: parent.width;
                height: 1px;
                background: #77746b;
            }

            if root.captured: Rectangle {
                x: clamp(root.playhead * parent.width - 6px, 0px, parent.width - self.width);
                width: 12px;
                height: parent.height;
                background: #e5fa36;
                opacity: 0.13;
            }

            Rectangle {
                x: root.playhead * (parent.width - 2px);
                width: root.captured ? 4px : 2px;
                height: parent.height;
                background: #e5fa36;
            }

            Path {
                x: 0px;
                y: 4px;
                width: parent.width;
                height: parent.height / 2 - 8px;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: 1000;
                viewbox-height: 32;
                commands: root.left-path;
                fill: #e5fa36;
                stroke: #e5fa36;
                stroke-width: 0.8px;
                opacity: 0.95;
            }

            Path {
                x: 0px;
                y: parent.height / 2 + 4px;
                width: parent.width;
                height: parent.height / 2 - 8px;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: 1000;
                viewbox-height: 32;
                commands: root.right-path;
                fill: #e5fa36;
                stroke: #e5fa36;
                stroke-width: 0.8px;
                opacity: 0.85;
            }

            Text {
                x: 8px;
                y: 6px;
                text: "L";
                color: #e5fa36;
                font-size: 9px;
                font-weight: 900;
            }
            Text {
                x: 8px;
                y: parent.height / 2 + 6px;
                text: "R";
                color: #f5f2e9;
                font-size: 9px;
                font-weight: 900;
            }
        }

        Text {
            height: root.captured ? 18px : 16px;
            text: root.status;
            color: #b4b8ac;
            font-size: root.captured ? 10px : 9px;
            font-weight: root.captured ? 900 : 700;
            overflow: elide;
        }
    }
}

export component BufferUppercutUi inherits Window {
    min-width: 920px;
    min-height: 620px;
    preferred-width: 1120px;
    preferred-height: 700px;
    background: #f5f2e9;
    default-font-family: "JetBrains Mono";

    in property <[PadView]> pads;
    in property <[MacroView]> macros;
    in property <int> selected-pad: 0;
    in property <string> selected-pad-note: "MIDI 60";
    in property <float> effect-value: 0.0;
    in property <string> effect-name: "Off";
    in property <string> tempo-text: "--.-";
    in-out property <bool> auto-select: true;
    in-out property <bool> direct-keys: false;
    in property <bool> key-learning: false;
    in property <bool> key-conflict: false;
    in property <string> key-status: "PHYSICAL KEYS · SELECT A PAD TO MAP";
    in property <float> pitch-value: 0.5;
    in property <string> pitch-text: "0 st";
    in property <string> waveform-left: "";
    in property <string> waveform-right: "";
    in property <float> waveform-playhead: 1.0;
    in property <bool> waveform-captured: false;
    in property <int> waveform-effect-index: 0;
    in property <string> waveform-mode: "ROLLING / 4 BEATS";
    in property <string> waveform-status: "STEREO HISTORY";
    in property <string> kit-display: "Classic";

    callback previous-kit();
    callback next-kit();
    callback auto-select-toggled(bool);
    callback direct-keys-toggled(bool);
    callback learn-key();
    callback cancel-learn();
    callback clear-key();
    callback reset-keys();
    callback swap-keys();
    callback pad-pressed(int);
    callback pad-released(int);
    callback effect-edit-began();
    callback effect-value-changed(float);
    callback effect-edit-ended();
    callback macro-edit-began(int);
    callback macro-value-changed(int, float);
    callback macro-edit-ended(int);

    Rectangle {
        x: 8px; y: 8px;
        width: parent.width - 16px; height: parent.height - 16px;
        background: transparent;
        border-width: 2px; border-color: #232726; border-radius: 9px;
    }

    VerticalLayout {
        padding: 18px;
        spacing: 8px;

        HorizontalLayout {
            height: 72px;
            spacing: 14px;
            VerticalLayout {
                min-width: 300px;
                preferred-width: 300px;
                horizontal-stretch: 3;
                alignment: center;
                spacing: 6px;
                Text {
                    text: "BUFFER UPPERCUT";
                    color: #202523;
                    font-size: 30px;
                    font-weight: 900;
                }
                Text {
                    text: "REAL-TIME AUDIO MANIPULATION";
                    color: #64675e;
                    font-size: 10px;
                }
            }
            Rectangle { width: 1px; background: #b6b8ac; }
            VerticalLayout {
                min-width: 170px;
                preferred-width: 200px;
                horizontal-stretch: 2;
                alignment: center;
                spacing: 7px;
                Text { text: "FACTORY KIT"; color: #64675e; font-size: 9px; }
                HorizontalLayout {
                    height: 34px;
                    spacing: 5px;
                    InstrumentButton { width: 28px; label: "‹"; clicked => { root.previous-kit(); } }
                    Rectangle {
                        background: #232726; border-radius: 4px;
                        Text {
                            x: 8px; width: parent.width - 16px;
                            text: root.kit-display; color: #e5fa36;
                            font-size: 11px; vertical-alignment: center; overflow: elide;
                        }
                    }
                    InstrumentButton { width: 28px; label: "›"; clicked => { root.next-kit(); } }
                }
            }
            Rectangle {
                min-width: 110px;
                preferred-width: 140px;
                horizontal-stretch: 1;
                background: #e5fa36; border-radius: 5px;
                VerticalLayout {
                    padding: 8px; spacing: 1px; alignment: center;
                    Text {
                        text: root.tempo-text; color: #202523;
                        font-size: 30px; font-weight: 900; horizontal-alignment: center;
                    }
                    Text { text: "HOST BPM"; color: #202523; font-size: 10px; horizontal-alignment: center; }
                }
            }
            VerticalLayout {
                width: 116px;
                alignment: center; spacing: 7px;
                Text { text: "PRESETS"; color: #64675e; font-size: 9px; }
                Text { text: "USE HOST MENU"; color: #202523; font-size: 11px; }
            }
            Rectangle {
                width: 86px;
                background: #232726; border-radius: 5px;
                InstrumentKnob {
                    width: parent.width; height: parent.height;
                    value: root.pitch-value; value-text: root.pitch-text;
                    label: "ACTIVE SHIFT"; interactive: false;
                }
            }
        }

        Rectangle { height: 1px; background: #232726; }

        WaveformPanel {
            min-height: 120px;
            vertical-stretch: 2;
            left-path: root.waveform-left;
            right-path: root.waveform-right;
            playhead: root.waveform-playhead;
            captured: root.waveform-captured;
            mode: root.waveform-mode;
            status: root.waveform-status;
        }

        HorizontalLayout {
            height: 24px; spacing: 12px;
            Text { text: "AUDIO IN"; color: #4b514b; font-size: 10px; vertical-alignment: center; }
            Rectangle { background: transparent; Rectangle { y: 12px; height: 1px; width: parent.width; background: #777d71; } }
            Text { text: "BUFFER ENGINE"; color: #202523; font-size: 10px; vertical-alignment: center; }
            Rectangle { background: transparent; Rectangle { y: 12px; height: 1px; width: parent.width; background: #777d71; } }
            Text { text: "SERIAL EFFECTS  →"; color: #202523; font-size: 10px; vertical-alignment: center; }
            Rectangle { background: transparent; Rectangle { y: 12px; height: 1px; width: parent.width; background: #777d71; } }
            Text { text: "AUDIO OUT"; color: #4b514b; font-size: 10px; vertical-alignment: center; }
        }

        workbench := Rectangle {
            min-width: 0px;
            min-height: 270px;
            vertical-stretch: 4;
            background: transparent;
            Rectangle {
                x: 0px; y: 0px;
                width: (workbench.width - 10px) * 0.60;
                height: workbench.height;
                background: #232726; border-radius: 6px;
                VerticalLayout {
                    padding: 12px; spacing: 10px;
                    HorizontalLayout {
                        height: 28px; spacing: 8px;
                        Text {
                            text: "PERFORMANCE KEYS";
                            min-width: 0px; overflow: elide;
                            color: #f5f2e9; font-size: 12px; font-weight: 800; vertical-alignment: center;
                        }
                        InstrumentSwitch {
                            checked: root.auto-select; label: "AUTO-SELECT MIDI";
                            toggled(value) => { root.auto-select = value; root.auto-select-toggled(value); }
                        }
                        InstrumentSwitch {
                            checked: root.direct-keys; label: "DIRECT KEYS";
                            toggled(value) => { root.direct-keys = value; root.direct-keys-toggled(value); }
                        }
                    }
                    Rectangle {
                        background: transparent; min-height: 0px; vertical-stretch: 1;
                        for pad[index] in root.pads: PerformancePad {
                            x: Math.mod(index, 4) * (parent.width + 7px) / 4;
                            y: Math.floor(index / 4) * (parent.height + 7px) / 4;
                            width: (parent.width - 21px) / 4;
                            height: (parent.height - 21px) / 4;
                            data: pad; index: index;
                            pressed(index) => { root.pad-pressed(index); }
                            released(index) => { root.pad-released(index); }
                        }
                    }
                }
            }
            Rectangle {
                x: (workbench.width - 10px) * 0.60 + 10px;
                y: 0px;
                width: (workbench.width - 10px) * 0.40;
                height: workbench.height;
                background: #232726; border-radius: 6px;
                VerticalLayout {
                    padding: 12px; spacing: 8px;
                    HorizontalLayout {
                        height: 28px;
                        Text { text: "PAD " + (root.selected-pad + 1); color: #f5f2e9; font-size: 18px; font-weight: 800; vertical-alignment: center; }
                        Text { text: root.selected-pad-note; color: #e5fa36; font-size: 10px; horizontal-alignment: right; vertical-alignment: center; }
                    }
                    Rectangle {
                        background: transparent; min-height: 0px; vertical-stretch: 1;
                        InstrumentKnob {
                            x: 0px; y: 0px;
                            width: (parent.width - 21px) / 4; height: (parent.height - 7px) / 2;
                            value: root.effect-value; value-text: root.effect-name;
                            label: "TYPE RESETS"; type-selector: true;
                            edit-began => { root.effect-edit-began(); }
                            value-changed(value) => { root.effect-value-changed(value); }
                            edit-ended => { root.effect-edit-ended(); }
                        }
                        for macro[index] in root.macros: InstrumentKnob {
                            x: Math.mod(index + 1, 4) * (parent.width + 7px) / 4;
                            y: Math.floor((index + 1) / 4) * (parent.height + 7px) / 2;
                            width: (parent.width - 21px) / 4; height: (parent.height - 7px) / 2;
                            value: macro.value; value-text: macro.value-text;
                            label: macro.label; enabled: macro.enabled;
                            edit-began => { root.macro-edit-began(index); }
                            value-changed(value) => { root.macro-value-changed(index, value); }
                            edit-ended => { root.macro-edit-ended(index); }
                        }
                    }
                    HorizontalLayout {
                        height: 25px; spacing: 6px;
                        InstrumentButton {
                            label: root.key-learning ? "CANCEL" : "LEARN KEY";
                            clicked => { if root.key-learning { root.cancel-learn(); } else { root.learn-key(); } }
                        }
                        if root.key-conflict: InstrumentButton {
                            label: "SWAP";
                            clicked => { root.swap-keys(); }
                        }
                        InstrumentButton { label: "CLEAR"; clicked => { root.clear-key(); } }
                        InstrumentButton { label: "RESET LAYOUT"; clicked => { root.reset-keys(); } }
                    }
                    Text {
                        height: 14px; min-width: 0px; overflow: elide;
                        text: root.key-status; color: root.key-learning ? #e5fa36 : #b4b8ac; font-size: 9px;
                        vertical-alignment: center;
                    }
                }
            }
        }
        Rectangle { height: 1px; background: #93978b; }
        HorizontalLayout {
            height: 14px;
            Text { text: "STEREO / MOMENTARY PERFORMANCE"; color: #64675e; font-size: 9px; }
            Text { text: "BUFFER UPPERCUT  //  LIVE"; color: #202523; font-size: 9px; horizontal-alignment: right; }
        }
    }
}
