---
import Layout from '../layouts/Layout.astro';
import slintBadge from '../assets/made-with-slint.png';
import { loadReleases, packagesFor, platforms, releasesUrl } from '../lib/releases.mjs';
const releases = await loadReleases();
const latest = releases.find((release) => packagesFor(release).length > 0);
const packages = latest ? packagesFor(latest) : [];
const checksums = latest?.assets.find((asset) => asset.name === 'SHA256SUMS');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const date = (value) => new Date(value).toLocaleDateString('en', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---
<Layout title="Downloads">
  <div class="page-heading"><p class="eyebrow">GET THE PLUGIN</p><h1>Downloads<span class="accent">.</span></h1><p class="lead">CLAP and VST3 for your DAW. No standalone application.</p></div>
  <div class="download-layout">
    <section aria-label="Latest downloads">
      <div class="release-heading"><h2>{latest ? latest.tag_name : 'First preview coming soon'}</h2>{latest && <span class="badge">{latest.prerelease ? 'Preview' : 'Release'}</span>}</div>
      {!latest && <p>There is no published, distributable build yet. Internal test candidates are not public downloads.</p>}
      <div class="download-cards">
        {platforms.map((platform) => {
          const download = packages.find((item) => item.slug === platform.slug);
          return <article class="download-card"><div><h3>{platform.name}</h3><p class="muted">{platform.detail}</p></div>{download ? <><span class="badge warning">Unsigned</span><a class="button" href={download.asset.browser_download_url}>Download ZIP <span class="size">{(download.asset.size / 1024 / 1024).toFixed(1)} MB</span></a></> : <span class="muted">Not available yet</span>}</article>;
        })}
      </div>
      <div class="notice"><h3>About unsigned builds</h3><p>Preview packages do not carry a trusted publisher signature. macOS previews are not Developer ID signed or notarized. Your operating system or DAW may warn about or block them.</p><p>Use previews in test projects and keep monitoring levels low. Do not disable antivirus or system-wide security protections.</p><a href={`${base}/installation/`}>Read installation instructions ↗</a></div>
      <p>{checksums && <a href={checksums.browser_download_url}>Download SHA-256 checksums · </a>}<a href={latest?.html_url ?? releasesUrl}>View release assets on GitHub ↗</a></p>
      <p class="muted">Checksums detect changed files. They do not replace code signing. See each release’s notes for architecture, OS requirements and known limitations.</p>
      <p style="margin-top: 2rem"><a href="https://slint.dev"><img src={slintBadge.src} width="160" height={Math.round(160 * slintBadge.height / slintBadge.width)} alt="Made with Slint" loading="lazy" /></a></p>
    </section>
    <aside class="release-sidebar" aria-labelledby="history-title"><p class="eyebrow">THE CHANGELOG</p><h2 id="history-title">Release history</h2>
      {releases.length === 0 ? <p class="muted">Published versions will appear here automatically, with dates and release notes.</p> : releases.map((release) => <article class="history-item"><a class="version" href={release.html_url}>{release.tag_name} ↗</a><time datetime={release.published_at}>{date(release.published_at)}</time><span class="badge">{release.prerelease ? 'Preview' : 'Release'}</span>{packagesFor(release).length > 0 && <span class="badge warning">Unsigned packages</span>}<details><summary>Release notes</summary><div class="release-notes">{release.body || 'See the release on GitHub for details.'}</div></details></article>)}
      <a class="text-link" href={releasesUrl}>All releases on GitHub ↗</a>
    </aside>
  </div>
</Layout>
