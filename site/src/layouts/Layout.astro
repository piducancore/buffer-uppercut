---
import '../styles/global.css';
import { repository } from '../lib/releases.mjs';
const { title, description = 'Buffer Uppercut: a real-time buffer performance effect. CLAP and VST3 plugins built in Rust with a native interface.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (path = '') => `${base.replace(/\/$/, '')}/${path}`;
const navigation = [['', 'Overview'], ['downloads/', 'Downloads'], ['installation/', 'Installation']];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Buffer Uppercut</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta name="theme-color" content="#121417" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="header wrap">
      <a class="brand" href={href()}>BUFFER <span>UPPERCUT</span><small>by piducancore</small></a>
      <nav aria-label="Main navigation">
        {navigation.map(([path, label]) => <a href={href(path)} aria-current={Astro.url.pathname.replace(/\/$/, '') === href(path).replace(/\/$/, '') ? 'page' : undefined}>{label}</a>)}
        <a href={`https://github.com/${repository}`}>Source ↗</a>
      </nav>
    </header>
    <main id="main" class="wrap"><slot /></main>
    <footer class="wrap footer"><span>Buffer Uppercut · Rust / TRUCE / Slint</span><a href={`https://github.com/${repository}/issues`}>Report an issue ↗</a></footer>
  </body>
</html>
